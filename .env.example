# ============================================================
# CampusX OS — Firebase Configuration (Project: campusx-os-erp)
# ============================================================
# Obtain your Web App API Key and App ID from:
# https://console.firebase.google.com/project/campusx-os-erp/settings/general
#
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=campusx-os-erp.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=campusx-os-erp
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=campusx-os-erp.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
